# ── Terraform ─────────────────────────────────────────────────────────────────
# Provider plugin cache (auto-downloaded by `terraform init` — do NOT commit)
infra/.terraform/
infra/.terraform.lock.hcl

# Terraform state — contains sensitive resource details; use remote backend in prod
infra/terraform.tfstate
infra/terraform.tfstate.backup

# ── Docker ────────────────────────────────────────────────────────────────────
# Docker volumes are stored outside the project tree — nothing to ignore here

# ── PySpark / Java ────────────────────────────────────────────────────────────
# Spark event logs and derby metastore created by local PySpark runs
spark-warehouse/
metastore_db/
derby.log
*.log

# ── Project-specific generated artifacts ─────────────────────────────────────
# Hadoop Windows binaries (auto-downloaded by run_pipeline.ps1 on first run)
hadoop/bin/winutils.exe
hadoop/bin/hadoop.dll

# Terraform CLI binary (auto-downloaded by setup.ps1 on first run)
bin/terraform.exe
bin/terraform.zip

# Screenshot helper (temporary utility script)
images/take_screenshots.ps1

